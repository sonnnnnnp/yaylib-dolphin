// 偽の Yay! サーバー（統合テスト用）。使い方: dolphin mock_server.dol <ポート>
@http := import["std:http"]
@os := import["std:os"]

@port := to_num[@os.args[]{0}]
@posts := {}
@puts := {}

@http.serve[@port, [@req] (
    @path := @req{"path"}
    @h := @req{"headers"}
    if @path == "/v2/users/login_with_email" (
        // ブラウザ版: アプリのヘッダーは付かない
        if map_has[@h, "x-app-version"] ( # {"status": 400, "json": {"error_code": -1, "message": "app headers on web login"}} )
        # {"json": {"user_id": 7, "access_token": "A1", "refresh_token": "R1"}}
    )
    if @path == "/v2/users/timestamp" ( # {"json": {"ip_address": "2.2.2.2", "time": 1}} )
    if @path == "/api/v1/oauth/token" (
        if map_get[@h, "authorization", ""] != "Basic ZTlmMWFlNGM0NDcwZjI5YTkyYzAxNjhkYzQyYjEzNjM3Y2MzMzI2OTIxMDNmMjNlNjI2YmMyYjAxNmY2NjYwMw==" (
            # {"status": 401, "json": {"error_code": -18}}
        )
        # {"json": {"access_token": "A2", "refresh_token": "R2", "id": 7}}
    )
    // 署名付き URL への PUT（認証なし）。受け取った大きさを覚えて 200 を返す
    if str_starts_with[@path, "/put/"] (
        arr_push[@puts, {"path": @path, "ct": map_get[@h, "content-type", ""], "len": bytes_len[@req{"raw"}], "auth": map_has[@h, "authorization"]}]
        # {"body": ""}
    )
    // 以降は認証が要る。A1 は期限切れ扱いにして、更新を試す
    @auth := map_get[@h, "authorization", ""]
    if @auth == "Bearer A1" ( # {"status": 401, "json": {"error_code": -3, "message": "expired"}} )
    if @auth != "Bearer A2" ( # {"status": 401, "json": {"error_code": -18}} )
    if @path == "/v2/posts/timeline" (
        # {"json": {"posts": @posts, "ip": map_get[@h, "x-client-ip", ""], "ua": map_get[@h, "user-agent", ""]}}
    )
    // 画像 1 枚の署名付き URL（本体とサムネイルの 2 つ）。クエリは同じ名前の最後だけ見えるので、
    // 最後がサムネイル（thumb_…）のときの 1 枚だけに対応する
    if @path == "/v1/buckets/presigned_urls" (
        @last := map_get[@req{"query"}, "file_names[]", ""]
        @main := str_replace[@last, "/thumb_", "/"]
        @base := "http://127.0.0.1:@{@port}/put"
        # {"json": {"presigned_urls": {
            {"filename": "s3/@{@main}", "url": "@{@base}/main"},
            {"filename": "s3/@{@last}", "url": "@{@base}/thumb"}
        }}}
    )
    if @path == "/v2/debug/puts" ( # {"json": {"puts": @puts}} )
    if @path == "/v3/posts/new" (
        arr_push[@posts, {"id": arr_len[@posts] + 1, "len": str_len[@req{"body"}], "ct": str_sub[@h{"content-type"}, 0, 19], "jwt": map_has[@h, "x-jwt"]}]
        # {"json": {"id": arr_len[@posts]}}
    )
    # {"status": 404, "json": {"error_code": -1, "message": "nope: @{@path}"}}
)]
