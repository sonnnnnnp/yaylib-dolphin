// 通信層のテスト。`send` を偽物に差し替えて、送ったものと返したものを確かめる
@client := import["../src/client.dol"]
@transport := import["../src/transport.dol"]
@util := import["../src/util.dol"]
@enc := import["std:encoding"]

// 応答の台本を順に返し、送られたリクエストを覚える偽の `send`
fake[@script] (
    @sent := {}
    @state := {"i": 0}
    @send := [@req] (
        arr_push[@sent, @req]
        @i := @state{"i"}
        @state{"i"} = @i + 1
        if @i < arr_len[@script] ( # @script{@i} )
        # {"status": 200, "ok": true, "headers": {:}, "body": "{}"}
    )
    # {"send": @send, "sent": @sent}
)

reply[@status, @body] (
    # {"status": @status, "ok": @status >= 200 && @status < 300, "headers": {:}, "body": @body}
)

make_client[@f, @extra = {:}] (
    @waits := {}
    @options := map_merge[{"send": @f{"send"}, "sleep": [@s] ( arr_push[@waits, @s] ), "device_uuid": "dev-1", "client_ip": "1.2.3.4"}, @extra]
    @c := @client.new_client[@options]
    @c{"test_waits"} = @waits
    # @c
)

get_req[@path] (
    # {"method": "GET", "path": @path, "query": "", "headers": {:}, "body": nil}
)

test_headers_are_injected[] (
    @f := fake[{}]
    @c := make_client[@f]
    @r := @transport.send_request[@c, get_req["/v1/x"]]
    assert_eq[@r{"status"}, 200]
    @sent := @f{"sent"}{0}
    assert_eq[@sent{"url"}, "https://api.yay.space/v1/x"]
    @h := @sent{"headers"}
    assert_eq[@h{"X-App-Version"}, "4.26"]
    assert_eq[@h{"X-Device-UUID"}, "dev-1"]
    assert_eq[@h{"X-Client-IP"}, "1.2.3.4"]
    assert_eq[@h{"X-Connection-Speed"}, "0 kbps"]
    assert_eq[@h{"Accept-Language"}, "ja"]
    assert_eq[@h{"User-Agent"}, "android 11 (3.5x 1440x2960 Galaxy S9)"]
    assert_eq[@h{"X-Device-Info"}, "yay 4.26.1 android 11 (3.5x 1440x2960 Galaxy S9)"]
    assert[map_has[@h, "X-Timestamp"]]
    // ログインしていないので Authorization はない
    assert[!map_has[@h, "Authorization"]]
)

test_bearer_and_caller_headers_win[] (
    @f := fake[{}]
    @c := make_client[@f]
    @client.set_tokens[@c, "acc-1", "ref-1"]
    @transport.send_request[@c, {"method": "GET", "path": "/v1/x", "query": "a=1", "headers": {"user-agent": "mine"}, "body": nil}]
    @h := @f{"sent"}{0}{"headers"}
    assert_eq[@h{"Authorization"}, "Bearer acc-1"]
    // 呼ぶ側のヘッダー（大文字小文字を問わず）が優先
    assert_eq[@h{"user-agent"}, "mine"]
    assert[!map_has[@h, "User-Agent"]]
    assert_eq[@f{"sent"}{0}{"url"}, "https://api.yay.space/v1/x?a=1"]
)

test_json_content_type_is_normalized[] (
    @f := fake[{}]
    @c := make_client[@f]
    @transport.send_request[@c, {"method": "POST", "path": "/v1/x", "query": "", "headers": {"Content-Type": "application/json"}, "body": str_to_bytes["{}"]}]
    assert_eq[@f{"sent"}{0}{"headers"}{"Content-Type"}, "application/json;charset=UTF-8"]
)

test_host_routing[] (
    @f := fake[{}]
    @c := make_client[@f]
    @transport.send_request[@c, get_req["/api/user_activities"]]
    assert_eq[@f{"sent"}{0}{"url"}, "https://cas.yay.space/api/user_activities"]
)

test_oauth_uses_basic_with_oauth_key[] (
    @f := fake[{}]
    @c := make_client[@f]
    @client.set_tokens[@c, "acc-1", "ref-1"]
    @transport.send_request[@c, {"method": "POST", "path": "/api/v1/oauth/token", "query": "", "headers": {:}, "body": nil}]
    @h := @f{"sent"}{0}{"headers"}
    assert_eq[@h{"Authorization"}, "Basic @{@enc.base64_encode[@c{"api_key"}]}"]
)

test_retry_5xx_on_get_with_backoff[] (
    @f := fake[{reply[503, ""], reply[500, ""], reply[200, "{}"]}]
    @c := make_client[@f]
    @r := @transport.send_request[@c, get_req["/v1/x"]]
    assert_eq[@r{"status"}, 200]
    assert_eq[arr_len[@f{"sent"}], 3]
    assert_eq[arr_len[@c{"test_waits"}], 2]
    // 待つ時間は 0 から base * 2^(n-2) まで
    assert[@c{"test_waits"}{0} >= 0 && @c{"test_waits"}{0} <= 0.2]
    assert[@c{"test_waits"}{1} >= 0 && @c{"test_waits"}{1} <= 0.4]
)

test_post_is_not_retried_but_429_is[] (
    @f := fake[{reply[503, ""]}]
    @c := make_client[@f]
    @r := @transport.send_request[@c, {"method": "POST", "path": "/v1/x", "query": "", "headers": {:}, "body": nil}]
    assert_eq[@r{"status"}, 503]
    assert_eq[arr_len[@f{"sent"}], 1]

    @f2 := fake[{reply[429, "{\"retry_in\": 7}"], reply[200, "{}"]}]
    @c2 := make_client[@f2]
    @r2 := @transport.send_request[@c2, {"method": "POST", "path": "/v1/x", "query": "", "headers": {:}, "body": nil}]
    assert_eq[@r2{"status"}, 200]
    // サーバーが `retry_in` を返したので、その秒数待つ
    assert_eq[@c2{"test_waits"}, {7}]
)

test_network_error_is_retried_then_returned[] (
    @f := fake[{err_new["network", "x"], err_new["network", "x"], err_new["network", "y"]}]
    @c := make_client[@f]
    @r := @transport.send_request[@c, get_req["/v1/x"]]
    assert[is_error[@r]]
    assert_eq[err_message[@r], "y"]
    assert_eq[arr_len[@f{"sent"}], 3]
)

test_401_refreshes_and_replays_once[] (
    @f := fake[
        {
            reply[401, "{\"error_code\": -3}"],
            reply[200, "{\"access_token\": \"acc-2\", \"refresh_token\": \"ref-2\", \"id\": 9}"],
            reply[200, "{\"ok\": true}"]
        }
    ]
    @c := make_client[@f]
    @client.set_tokens[@c, "acc-1", "ref-1"]
    @r := @transport.send_request[@c, get_req["/v1/x"]]
    assert_eq[@r{"status"}, 200]
    @sent := @f{"sent"}
    assert_eq[arr_len[@sent], 3]
    assert_eq[@sent{0}{"headers"}{"Authorization"}, "Bearer acc-1"]
    // 2 つ目は更新（OAuth）。refresh_token を送る
    assert_eq[@sent{1}{"url"}, "https://api.yay.space/api/v1/oauth/token"]
    assert_eq[bytes_to_str[@sent{1}{"body"}], "grant_type=refresh_token&refresh_token=ref-1"]
    // 3 つ目は新しいトークンで送り直し
    assert_eq[@sent{2}{"headers"}{"Authorization"}, "Bearer acc-2"]
    assert_eq[@c{"access_token"}, "acc-2"]
    assert_eq[@c{"refresh_token"}, "ref-2"]
)

test_401_without_refresh_token_returns_original[] (
    @f := fake[{reply[401, "{\"error_code\": -3}"]}]
    @c := make_client[@f]
    @r := @transport.send_request[@c, get_req["/v1/x"]]
    assert_eq[@r{"status"}, 401]
    assert_eq[arr_len[@f{"sent"}], 1]
)

test_401_when_refresh_fails_returns_original_401[] (
    @f := fake[{reply[401, "{\"error_code\": -3}"], reply[401, "{\"error_code\": -18}"]}]
    @c := make_client[@f]
    @client.set_tokens[@c, "acc-1", "ref-1"]
    @r := @transport.send_request[@c, get_req["/v1/x"]]
    assert_eq[@r{"status"}, 401]
    assert_eq[@r{"body"}, "{\"error_code\": -3}"]
    // 更新が失敗しても、OAuth の 401 でループしない
    assert_eq[arr_len[@f{"sent"}], 2]
)

test_client_ip_is_fetched_once_after_first_request[] (
    @f := fake[{reply[200, "{}"], reply[200, "{\"ip_address\": \"9.9.9.9\"}"]}]
    @c := make_client[@f, {"client_ip": ""}]
    @transport.send_request[@c, get_req["/v1/x"]]
    assert_eq[@c{"client_ip"}, "9.9.9.9"]
    assert_eq[@f{"sent"}{1}{"url"}, "https://api.yay.space/v2/users/timestamp"]
    @transport.send_request[@c, get_req["/v1/y"]]
    assert_eq[@f{"sent"}{2}{"headers"}{"X-Client-IP"}, "9.9.9.9"]
    assert_eq[arr_len[@f{"sent"}], 3]
)
